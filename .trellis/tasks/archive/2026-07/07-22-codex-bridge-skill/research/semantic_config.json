{
  "optimizer_hints": {
    "capability": "Bridge an explicit user request from the current agent to Codex CLI through a validated file-backed bundle",
    "inputs": [
      "plans",
      "approved coding tasks",
      "review comments",
      "pattern candidates",
      "project files"
    ],
    "trigger_actions": [
      "ask Codex to review a plan",
      "delegate implementation to Codex",
      "ask Codex to revise its implementation",
      "ask Codex to verify extrapolated candidates",
      "让 Codex 审计划",
      "交给 Codex 实现"
    ],
    "exclusions": [
      "ordinary code review without explicit Codex participation",
      "direct implementation by the current agent",
      "generic dynamic multi-agent orchestration",
      "repository health audits",
      "session handoff",
      "explanation or summary only"
    ],
    "artifacts": [
      "file-backed bundle",
      "request.md",
      "manifest.json",
      "response.json"
    ]
  },
  "fallback_positive_concepts": [
    "explicit_codex",
    "bridge_action",
    "bundle_contract"
  ],
